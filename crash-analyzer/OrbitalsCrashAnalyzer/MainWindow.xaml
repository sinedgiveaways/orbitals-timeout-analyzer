<Window x:Class="OrbitalsCrashAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbitals Crash Analyzer — TLS / NSO" Height="900" Width="1450"
        MinHeight="680" MinWidth="1050" Background="#FF0F1722" Foreground="#FFE6EDF3"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="ORBITALS CRASH ANALYZER" FontSize="25" FontWeight="Bold" Foreground="#FF64B5F6"/>
            <TextBlock Text="Profil TLS préchargé • log et modules NSO facultatifs • analyse locale" Foreground="#FF9BA9B8" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FF18212F" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="LOG DE CRASH — FACULTATIF" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <DockPanel>
                        <Button Content="Charger log..." Padding="12,7" Click="LoadLog_Click" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="LogPathText" Text="Facultatif — résultats antérieurs intégrés" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,0,0" Foreground="#FF9BA9B8"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,10,0">
                    <TextBlock Text="EXEFS / main — FACULTATIF" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <DockPanel>
                        <Button Content="Charger main..." Padding="12,7" Click="LoadMain_Click" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="MainPathText" Text="Facultatif" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,0,0" Foreground="#FF9BA9B8"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="EXEFS / sdk — FACULTATIF" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <DockPanel>
                        <Button Content="Charger sdk..." Padding="12,7" Click="LoadSdk_Click" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="SdkPathText" Text="Facultatif — pour vérification binaire" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="9,0,0,0" Foreground="#FF9BA9B8"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Background="#FF18212F" Foreground="#FFE6EDF3" BorderBrush="#FF344255">
            <TabItem Header="Rapport complet">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="ACTUALISER LE RAPPORT TLS" Click="Analyze_Click" Padding="18,9" Background="#FF176B55" Foreground="White" BorderThickness="0" FontWeight="Bold"/>
                        <Button Content="Exporter le rapport..." Click="Export_Click" Padding="16,9" Margin="10,0,0,0" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                    </DockPanel>
                    <TextBox x:Name="ReportBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13" Background="#FF101923" Foreground="#FFD8E2EC"
                             BorderBrush="#FF344255" Padding="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="Mode d'emploi">
                <ScrollViewer Margin="18" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Analyse TLS ciblée — procédure" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Text="Le profil d'enquête TLS et les résultats déjà établis sont intégrés à l'application : aucun fichier n'est nécessaire pour les consulter. Le log, exefs/main et exefs/sdk sont facultatifs et ne doivent être ajoutés que si une vérification ciblée l'exige."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="L'analyse extrait les frames main+0x et sdk+0x du journal, puis ajoute les points de repère TLS connus : AllocateTlsSlot (sdk+0x16B670), GetTlsValue (sdk+0x16B730), SearchUnusedTlsSlotUnsafe (sdk+0x16C520), constructeurs TlsManager (sdk+0x16C7B0) et AllocateTlsSlot (sdk+0x16CC30)."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="Les segments NSO compressés LZ4 sont décompressés en mémoire. Les recherches de chaînes et de constantes sont des indices statiques, pas des preuves d'exécution."/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" Text="Les fichiers sélectionnés sont analysés localement. Aucun log ni binaire n'est envoyé par l'application. Le log original n'est pas embarqué octet par octet : il reste facultatif pour l'analyse de nouveaux événements." Foreground="#FF80CBC4"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,14,0,0" Text="Limites de cette version : décodeur ARM64 partiel ; pas encore de lecture complète des tables ELF dynsym/relocations, ni désassemblage du code hôte x86-64, ni reconstruction automatique de toutes les fonctions. Le rapport signale ces limites au lieu de prétendre avoir prouvé une cause racine."/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="Orbitals Crash Analyzer 0.4.0 • Profil TLS intégré • Aucun cycle de préparation ou recompilation du jeu" Foreground="#FF718096" Margin="0,12,0,0"/>
    </Grid>
</Window>