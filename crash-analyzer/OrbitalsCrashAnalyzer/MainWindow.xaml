<Window x:Class="OrbitalsCrashAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orbitals Crash Analyzer" Height="820" Width="1280"
        MinHeight="620" MinWidth="920" Background="#FF0F1722" Foreground="#FFE6EDF3"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="ORBITALS CRASH ANALYZER" FontSize="25" FontWeight="Bold" Foreground="#FF64B5F6"/>
            <TextBlock Text="Analyse locale des logs de crash et des segments NSO ARM64" Foreground="#FF9BA9B8" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FF18212F" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="LOG DE CRASH" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <DockPanel>
                        <Button x:Name="LoadLogButton" Content="Charger un log..." Padding="14,7" Click="LoadLog_Click" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="LogPathText" Text="Aucun fichier sélectionné" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF9BA9B8"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="EXEFS / main (NSO)" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <DockPanel>
                        <Button x:Name="LoadNsoButton" Content="Charger main..." Padding="14,7" Click="LoadNso_Click" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                        <TextBlock x:Name="NsoPathText" Text="Facultatif — aucun fichier sélectionné" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#FF9BA9B8"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Background="#FF18212F" Foreground="#FFE6EDF3" BorderBrush="#FF344255">
            <TabItem Header="Synthèse">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Analyser les fichiers chargés" Click="Analyze_Click" Padding="16,8" Background="#FF176B55" Foreground="White" BorderThickness="0"/>
                        <Button Content="Exporter le rapport..." Click="Export_Click" Padding="16,8" Margin="10,0,0,0" Background="#FF25415C" Foreground="White" BorderThickness="0"/>
                    </DockPanel>
                    <TextBox x:Name="ReportBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="13" Background="#FF101923" Foreground="#FFD8E2EC"
                             BorderBrush="#FF344255" Padding="12"/>
                </Grid>
            </TabItem>
            <TabItem Header="À propos / limites">
                <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Version initiale — 0.1.0" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock TextWrapping="Wrap" Text="Cette version lit les logs, repère les signatures de crash connues et inspecte l'en-tête NSO ainsi que les segments. Les segments LZ4 sont décompressés pour permettre les recherches binaires. Elle ne prétend pas encore remplacer un désassembleur ARM64 complet ni prouver la cause racine d'une corruption mémoire."/>
                        <TextBlock Text="Les résultats sont des indices : une signature ou une référence trouvée ne démontre pas à elle seule le chemin d'exécution au moment du crash." Margin="0,12,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Les fichiers sont analysés localement. Aucun log ni binaire n'est envoyé à GitHub par l'application." Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF80CBC4"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="3" Text="Orbitals Crash Analyzer • Analyse locale • Résultats à confirmer par désassemblage et reproduction" Foreground="#FF718096" Margin="0,12,0,0"/>
    </Grid>
</Window>
